// Generated from accepted u332 integer reference. x/y are absolute screen phase.
function [7:0] framebuffer_q8_encode(input [15:0] p,input [1:0] yy,input [1:0] xx);
 localparam [1535:0] LUT_R=1536';
 reg [2:0] r;
 localparam [3071:0] LUT_G=3072';
 reg [2:0] g;
 localparam [1023:0] LUT_B=1024'hfffeaaaaa5555500faaaaa5555540000fffaaaaa55555400eaaaa95555500000ffeaaaa955555000fffffaaaaa555554feaaaaa555550000ffffaaaaa9555540fffaaaaa95555400eaaaaa5555500000ffffaaaaa5555540feaaaa9555550000ffaaaaa555554000ffffeaaaaa555550ffeaaaaa55555000fffffaaaaa955554;
 reg [1:0] b;
 begin
 r=LUT_R[{yy,xx,p[15:11]}*3 +: 3];
 g=LUT_G[{yy,xx,p[10:5]}*3 +: 3];
 b=LUT_B[{yy,xx,p[4:0]}*2 +: 2];
 framebuffer_q8_encode={r,g,b};
 end
endfunction
