{
  "game": [
    {
      "stage": "map",
      "cwd": "${SOURCE}",
      "args": [
        "${EFINITY_ROOT}/bin/efx_map.exe",
        "--project",
        "ti60f225_oob",
        "--family",
        "Titanium",
        "--device",
        "Ti60F225",
        "--output-dir",
        "${BUILD}/map",
        "--I",
        "${SOURCE}/ip/axi_interconnect_3to1",
        "--I",
        "${SOURCE}/ip/riscv_soc",
        "--project-xml",
        "${PROJECT}",
        "--binary-db",
        "${BUILD}/map/ti60f225_oob.vdb",
        "--peri-syn-instantiation=0",
        "--peri-syn-inference=0",
        "--peri-syn-modify-vdb-module-name=0",
        "--root=ti60f225_oob_top",
        "--veri_options=verilog_mode=sv_09,vhdl_mode=vhdl_2008",
        "--work-dir=${BUILD}/map_work",
        "--write-efx-verilog=${BUILD}/map/ti60f225_oob.map.v"
      ]
    },
    {
      "stage": "interface",
      "cwd": "${SOURCE}",
      "args": [
        "${EFINITY_ROOT}/python311/bin/python.exe",
        "${EFINITY_ROOT}/scripts/efx_run_pt_unified.py",
        "ti60f225_oob",
        "Titanium",
        "Ti60F225",
        "--timing_model",
        "I3",
        "--project_xml",
        "${PROJECT}",
        "--output_dir",
        "${BUILD}/map",
        "--work_dir",
        "${BUILD}/pnr_work"
      ]
    },
    {
      "stage": "pack",
      "cwd": "${SOURCE}",
      "args": [
        "${EFINITY_ROOT}/bin/efx_pnr.exe",
        "--circuit",
        "ti60f225_oob",
        "--family",
        "Titanium",
        "--device",
        "Ti60F225",
        "--operating_conditions",
        "I3",
        "--vdb_file",
        "${BUILD}/map/ti60f225_oob.vdb",
        "--use_vdb_file",
        "on",
        "--prj",
        "${PROJECT}",
        "--output_dir",
        "${BUILD}/map",
        "--work_dir",
        "${BUILD}/pnr_work",
        "--place_file",
        "${BUILD}/map/ti60f225_oob.place",
        "--route_file",
        "${BUILD}/map/ti60f225_oob.route",
        "--sync_file",
        "${BUILD}/map/ti60f225_oob.interface.csv",
        "--generate_prevpr_netlist",
        "off",
        "--sdc_file=ti60f225_oob.sdc",
        "--seed",
        "5",
        "--optimization_level",
        "TIMING_1",
        "--pack"
      ]
    },
    {
      "stage": "pnr",
      "cwd": "${SOURCE}",
      "args": [
        "${EFINITY_ROOT}/bin/efx_pnr.exe",
        "--circuit",
        "ti60f225_oob",
        "--family",
        "Titanium",
        "--device",
        "Ti60F225",
        "--operating_conditions",
        "I3",
        "--vdb_file",
        "${BUILD}/map/ti60f225_oob.vdb",
        "--use_vdb_file",
        "on",
        "--prj",
        "${PROJECT}",
        "--output_dir",
        "${BUILD}/map",
        "--work_dir",
        "${BUILD}/pnr_work",
        "--place_file",
        "${BUILD}/map/ti60f225_oob.place",
        "--route_file",
        "${BUILD}/map/ti60f225_oob.route",
        "--sync_file",
        "${BUILD}/map/ti60f225_oob.interface.csv",
        "--generate_prevpr_netlist",
        "off",
        "--sdc_file=ti60f225_oob.sdc",
        "--seed",
        "5",
        "--optimization_level",
        "TIMING_1"
      ]
    },
    {
      "stage": "pgm",
      "cwd": "${SOURCE}",
      "args": [
        "${EFINITY_ROOT}/bin/efx_pgm.exe",
        "--interface_designer_settings",
        "${BUILD}/map/ti60f225_oob_or.ini",
        "--periph",
        "${BUILD}/map/ti60f225_oob.lpf",
        "--family",
        "Titanium",
        "--device",
        "Ti60F225",
        "--source",
        "${BUILD}/pnr_work/ti60f225_oob.lbf",
        "--dest",
        "${BUILD}/map/ti60f225_oob.hex",
        "--mode=active",
        "--width=1",
        "--enable_roms=on",
        "--spi_low_power_mode=on",
        "--io_weak_pullup=on",
        "--oscillator_clock_divider=DIV8",
        "--enable_crc_check=on",
        "--bitstream_compression=on",
        "--active_capture_clk_edge=posedge",
        "--release_tri_then_reset=on",
        "--enable_external_master_clock=off",
        "--jtag_usercode=0xFFFFFFFF"
      ]
    }
  ],
  "basic": [
    {
