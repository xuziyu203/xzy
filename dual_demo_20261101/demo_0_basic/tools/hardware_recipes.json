        "Titanium",
        "Ti60F225",
        "--timing_model",
        "I3",
        "--project_xml",
        "${PROJECT}",
        "--output_dir",
        "${BUILD}/map",
        "--work_dir",
        "${BUILD}/pnr_work"
      ]
    },
    {
      "stage": "pnr",
      "cwd": "${SOURCE}",
      "args": [
        "${EFINITY_ROOT}/bin/efx_pnr.exe",
        "--circuit",
        "ti60f225_oob",
        "--family",
        "Titanium",
        "--device",
        "Ti60F225",
        "--operating_conditions",
        "I3",
        "--vdb_file",
        "${BUILD}/map/ti60f225_oob.vdb",
        "--use_vdb_file",
        "on",
        "--prj",
        "${PROJECT}",
        "--output_dir",
        "${BUILD}/map",
        "--work_dir",
        "${BUILD}/pnr_work",
        "--place_file",
        "${BUILD}/map/ti60f225_oob.place",
        "--route_file",
        "${BUILD}/map/ti60f225_oob.route",
        "--sync_file",
        "${BUILD}/map/ti60f225_oob.interface.csv",
        "--generate_prevpr_netlist",
